{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortKiller",
  "version": "1.1.0",
  "identifier": "com.portkiller.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/embed-icon.cjs"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "PortKiller",
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false,
        "center": true,
        "width": 580,
        "height": 680,
        "minWidth": 460,
        "minHeight": 460,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "fullscreen": false,
        "focus": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "",
    "shortDescription": "Port Process Killer Utility",
    "longDescription": "The fastest way for developers to visualize and terminate processes locking specific ports",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "targets": ["nsis", "msi"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDOUI3NzRCQTg2OUUzQ0EKUldUSzQybW9TM2ViSEs3QTNwS0N1ZkJWMnpDd0ozWW5mS09pTHF6VlQ0dTk1UDBLVUxCdGRBMFUK",
      "endpoints": [
        "https://github.com/Razee4315/portkiller/releases/latest/download/latest.json"
      ]
    }
  }
}
